APP_ENV=local
APP_NAME=UniSystem API

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name
# Only needed when running the API in Docker Desktop; use your local PostgreSQL credentials.
DOCKER_DATABASE_URL=postgresql+asyncpg://username:password@host.docker.internal:5432/database_name
REDIS_URL=redis://localhost:6379/0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dacn
CLOUDINARY_DELIVERY_TYPE=authenticated

MAX_REPORT_BYTES=52428800
MAX_SOURCE_BYTES=209715200
# PaddleOCR Official API. Obtain the token from AI Studio; never commit it.
OCR_PROVIDER=paddle_official
# file: one complete PDF job; auto: URL/file/page fallback; pages: parallel page jobs
PADDLEOCR_UPLOAD_MODE=file
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_CONNECT_TIMEOUT_SECONDS=30
PADDLEOCR_REQUEST_TIMEOUT_SECONDS=300
PADDLEOCR_UPLOAD_TIMEOUT_SECONDS=60
PADDLEOCR_POLL_TIMEOUT_SECONDS=1800
PADDLEOCR_POLL_INTERVAL_SECONDS=5
PADDLEOCR_RETRY_ATTEMPTS=4
PADDLEOCR_RETRY_BACKOFF_SECONDS=2
PADDLEOCR_PAGE_CONCURRENCY=3
OCR_MAX_OUTPUT_BYTES=33554432

# Optional local fallback: set OCR_PROVIDER=local.
OCR_DEVICE=cpu
OCR_PIPELINE_VERSION=v1.5

# Optional Colab GPU microservice: set OCR_PROVIDER=colab
# OCR_COLAB_URL=https://your-colab-tunnel.trycloudflare.com


# Claim extraction still calls an LLM endpoint.
CLAIM_LLM_URL=
CLAIM_LLM_API_KEY=
CLAIM_LLM_MODEL=

# Pipeline 2 citation verification. If omitted, these fall back to CLAIM_LLM_*.
# The provider must support OpenAI-compatible POST /chat/completions JSON responses.
CITATION_LLM_URL=
CITATION_LLM_API_KEY=
CITATION_LLM_MODEL=
CITATION_JUDGE_MAX_INPUT_CHARS=24000
CITATION_JUDGE_MAX_EVIDENCE_ITEMS=12
CITATION_JUDGE_MAX_ATOMIC_CLAIMS=8
CITATION_JUDGE_CONFIDENCE_THRESHOLD=0.8

CODE_LLM_URL=
CODE_LLM_API_KEY=
CODE_LLM_MODEL=
CODE_JUDGE_MAX_CARDS=6
CODE_JUDGE_CONCURRENCY=4

GRAPHIFY_VERSION=0.9.55
GRAPHIFY_TIMEOUT_SECONDS=1800
GRAPHIFY_MAX_WORKERS=4

# Reference metadata resolver
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_MAILTO=your-email@example.com
REFERENCE_RESOLVER_TIMEOUT_SECONDS=20
REFERENCE_RESOLVER_MAX_CANDIDATES=3
REFERENCE_RESOLVER_MATCH_THRESHOLD=0.85
REFERENCE_RESOLVER_MARGIN_THRESHOLD=0.10
REFERENCE_RESOLVER_CONCURRENCY=4
REFERENCE_RESOLVER_VERSION=crossref-1
